APP_ENV=local
APP_MODE=operational
AUTH_ENABLED=false
STORAGE_MODE=oci
OCI_BUCKET_NAME=mediflow-testes
OCI_NAMESPACE=<namespace-do-bucket>
OCI_CONFIG_FILE=/run/oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_CONFIG_HOST_FILE=<caminho-absoluto-config-docker>
OCI_KEY_HOST_FILE=<caminho-absoluto-chave-pem>
GEMINI_API_KEY=<chave-privada>
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_ATTEMPTS=2
WEBHOOK_URL=
WEBHOOK_TOKEN=
