# Copie para .env.notificador.local (ignorado pelo Git).
# Mesmo token WEBHOOK_TOKEN configurado na API, com pelo menos 32 caracteres.
WEBHOOK_TOKEN=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURITY="starttls"
SMTP_USERNAME=""
# Senha de app do Gmail, não a senha normal da conta.
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_TO=""
SMTP_TIMEOUT=3
# Opcional: CA adicional ja confiavel no host (inspecao TLS de antivirus).
SMTP_CA_FILE=""
