# Modelo de configuração: copie para .env e preencha os valores necessários.
# O app lê .env; alterações neste exemplo não alteram a execução.
# Preserve suas credenciais ao atualizar um .env existente e não as publique.

# --- Ambiente de hospedagem: independente de Docker e do armazenamento ---
# local: execução local; cloud: aplicação hospedada na nuvem.
# Defina explicitamente na implantação; usar OCI ou Docker não altera este valor.
APP_ENV="local"
# operational: análise normal. presentation: dados temporários e sem webhook.
# Apresentação exige STORAGE_MODE=memory; valores incompatíveis impedem iniciar.
APP_MODE="operational"
# Em apresentação, false usa exemplos TXT predefinidos sem LLM; true usa Gemini real.
# Sem fallback automático. Alterações exigem reiniciar a API.
PRESENTATION_USE_LLM="false"

# --- Gemini: processamento dos documentos em qualquer modo de armazenamento ---
# Preencha com sua chave da API Gemini e escolha o modelo utilizado pelo app.
GEMINI_API_KEY="sua_chave_gemini"
GEMINI_MODEL_NAME="gemini-3.5-flash"

# --- Armazenamento: escolha onde os documentos serão salvos ---
# memory: dados em memória, perdidos ao reiniciar a aplicação; dispensa OCI.
# emulator: simulação local da OCI; exige o container oci-emulator em execução.
# oci: Oracle Cloud real; exige credenciais e acesso ao bucket na nuvem.
STORAGE_MODE="memory"

# Usado somente em emulator, quando a API roda no Windows e o emulador no Docker.
# Ao incluir docker-compose.oci-local.yml, o Compose define automaticamente
# STORAGE_MODE=emulator e OCI_SERVICE_ENDPOINT=http://oci-emulator:4599 na API,
# sobrepondo os valores deste arquivo para esse container.
# O volume do Compose preserva os dados do emulador entre reinícios.
OCI_SERVICE_ENDPOINT="http://localhost:4599"

# Namespace e bucket usados em emulator e oci; em memory são ignorados.
# Em emulator, o bucket é criado automaticamente e o namespace pode ser fictício.
# Em oci, informe os valores reais da sua conta e do bucket de destino.
OCI_NAMESPACE="seu_tenancy_namespace"
OCI_BUCKET_NAME="mediflow-documentos-clinicos"

# --- Credenciais Oracle: necessárias somente em oci ---
# Caminho do arquivo de credenciais e nome do perfil dentro dele.
# O arquivo e a chave privada referenciada precisam estar acessíveis à API
# no ambiente em que ela roda (Windows ou container).
OCI_CONFIG_FILE="~/.oci/config"
OCI_CONFIG_PROFILE="DEFAULT"
# Somente docker-compose.oci-cloud.yml: caminhos absolutos no computador host.
# Em config.docker, key_file deve ser /run/oci/mediflow_api_key.pem.
# Exemplos Windows: C:/Users/SEU_USUARIO/.oci/config.docker e .../mediflow_api_key.pem.
OCI_CONFIG_HOST_FILE=""
OCI_KEY_HOST_FILE=""

# --- Autenticação: independente do modo de armazenamento ---
# false: acesso sem login. true: exige login OIDC e e-mail autorizado na interface,
# além da credencial de serviço nas chamadas à API (exceto GET /health).
# Antes de ativar, copie .streamlit/secrets.example.toml para
# .streamlit/secrets.toml e configure o cliente OAuth, o retorno e o cookie secret.
AUTH_ENABLED="false"

# Nome do provedor: deve corresponder à seção em secrets.toml, como [auth.google].
AUTH_PROVIDER="google"
# E-mails autorizados separados por vírgula; obrigatório quando o login está ativo.
AUTH_ALLOWED_EMAILS=""
# Credencial aleatória de pelo menos 32 caracteres, idêntica na interface e na API.
# Obrigatória com autenticação ativa; mantenha este exemplo sem uma credencial real.
MEDIFLOW_API_TOKEN=""
# No Docker, inclua docker-compose.auth.yml para habilitar a autenticação e montar
# secrets.toml na interface. Esse complemento força AUTH_ENABLED=true na UI/API
# e exige AUTH_ALLOWED_EMAILS e MEDIFLOW_API_TOKEN preenchidos.

# --- Alertas: integração opcional ---
# Vazio: registra alertas apenas em log. Preencha para enviar ao webhook configurado.
WEBHOOK_URL=""
# Opcional: token Bearer para webhooks autenticados.
WEBHOOK_TOKEN=""
